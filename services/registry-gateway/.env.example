# Soviez Registry Gateway — example environment (NO real secrets)
# Copy to .env on the gateway host and fill in operator-managed values.
# Upstream Hub credentials MUST remain only on this host; never return them to clients.

# Listen port inside the container / process
PORT=8087

# Public ticket verification keys (Ed25519 raw public key, base64url)
# Shape: { "rtk_<id>": "<base64url-raw-pubkey>" }
SOVIEZ_REGISTRY_TICKET_PUBLIC_KEYS_JSON={"rtk_example":"REPLACE_WITH_BASE64URL_RAW_ED25519_PUBLIC_KEY"}

# Upstream Docker Hub (or compatible) — server-side only
SOVIEZ_UPSTREAM_REGISTRY_HOST=registry-1.docker.io
SOVIEZ_UPSTREAM_REGISTRY_USER=REPLACE_WITH_HUB_USERNAME
SOVIEZ_UPSTREAM_REGISTRY_TOKEN=REPLACE_WITH_HUB_TOKEN_OR_PAT

# Optional: full upstream base URL override (dev/mock only)
# SOVIEZ_UPSTREAM_BASE_URL=http://127.0.0.1:18087

# Canonical public hostnames (TLS terminated at nginx)
# Production: registry.soviez.com
# Staging:    registry-staging.soviez.com
