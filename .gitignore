# Secrets / local credentials
.env
.env.*
!.env.example
keys.json
ticket.token
offline-package.json
docker-auth/
config.json

# Temp / local runtime
.tmp/
.tmp.*
tmp/
*.log
.DS_Store

# Python / venv
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
coverage/

# Node
node_modules/

# Local data / dumps (not fixtures)
*.dump
*.backup
test-filestore/
local-filestore/

# Private keys / PKCS (keep synthetic fixtures under tests/ via negation if needed)
*.p12
*.pfx
# Allow synthetic test fixtures only
!tests/**/fixtures/**/*.pem
!tests/**/fixtures/**/synthetic*.pem

# Editor / OS
.idea/
.vscode/
*.swp

# Service build artifacts (defensive — do not re-add internal services here)
services/*/dist/
services/*/node_modules/
